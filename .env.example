# Copy to .env.local and fill in. Never commit a filled-in file.
# Every variable below is required; lib/env.ts fails the build if one is missing.
# ARCHITECTURE.md section 9.1 is the authoritative table.

# --- Public: inlined into the client bundle. Never put a secret here. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=

# --- Server only: read exclusively through the `server` object in lib/env.ts. ---
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
